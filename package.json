{
  "name": "leadflow-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "preflight": "node scripts/check-toolchain.mjs",
    "tools:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-phase1-tools.ps1",
    "tools:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-phase1-tools.ps1 -Offline",
    "emulator:start": "node scripts/run-firestore-emulator.mjs start",
    "emulator:exec": "node scripts/run-firestore-emulator.mjs exec",
    "emulator:runtime": "node scripts/run-firestore-emulator.mjs runtime",
    "emulator:start:retain": "node scripts/run-firestore-emulator.mjs retain",
    "emulator:export": "node scripts/run-firestore-emulator.mjs export",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.check.json --pretty false",
    "test": "vitest run",
    "eval": "node packages/evals/dist/run.js",
    "build": "node scripts/run-workspace-builds.mjs",
    "smoke": "node scripts/run-smokes.mjs",
    "governance": "node scripts/run-governance.mjs",
    "api:local": "node scripts/run-local-api.mjs",
    "enrichment:probe": "node scripts/run-enrichment-probe.mjs",
    "docs:diagrams": "node scripts/generate-diagrams.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "check:openspec": "openspec validate --all --strict",
    "check": "node scripts/run-checks.mjs",
    "audit:dependencies": "node scripts/run-pnpm-audit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "firebase-tools": "15.34.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
